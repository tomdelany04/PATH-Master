        <mxCell id="8" value="Generate covariates&#xa;(X1, X2, X3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="165" width="280" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="Randomize treatment&#xa;(Z ~ Bernoulli 0.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="270" width="280" height="76" as="geometry"/>
        </mxCell>
