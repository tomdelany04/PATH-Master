          <mxGeometry x="145" y="610" width="210" height="42" as="geometry"/>
        </mxCell>

        <mxCell id="15" value="Repeat over 1000 replicates" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff6c8;strokeColor=#555555;strokeWidth=2;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="135" width="260" height="44" as="geometry"/>
