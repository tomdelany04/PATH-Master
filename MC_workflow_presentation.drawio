          <mxGeometry x="125" y="375" width="250" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Null truth&#xa;constant treatment effect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4fff0;strokeColor=#555555;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="490" width="150" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="HTE truth&#xa;treatment effect depends on X1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f5;strokeColor=#555555;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="490" width="170" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="Generate binary outcome" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=20;fontStyle=1;" vertex="1" parent="1">
