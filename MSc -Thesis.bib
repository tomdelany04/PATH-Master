@article{janssenSimpleMethodAdjust2009,
  title = {A Simple Method to Adjust Clinical Prediction Models to Local Circumstances},
  author = {Janssen, Kristel J. M. and Vergouwe, Yvonne and Kalkman, Cor J. and Grobbee, Diederick E. and Moons, Karel G. M.},
  year = 2009,
  month = mar,
  journal = {Canadian Journal of Anesthesia/Journal canadien d'anesth\'esie},
  volume = {56},
  number = {3},
  pages = {194--201},
  issn = {1496-8975},
  doi = {10.1007/s12630-009-9041-x},
  abstract = {Clinical prediction models estimate the risk of having or developing a particular outcome or disease. Researchers often develop a new model when a previously developed model is validated and the performance is poor. However, the model can be adjusted (updated) using the new data. The updated model is then based on both the development and validation data. We show how a simple updating method may suffice to update a clinical prediction model.}
}

@article{JONES20041025,
  title = {Predictors of Mortality in Patients with Heart Failure and Preserved Systolic Function in the {{Digitalis Investigation Group}} Trial},
